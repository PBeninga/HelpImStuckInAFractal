# Copy to server/.env and fill in. Never commit server/.env (it is git-ignored).

# --- OpenAI (the voice agent) ---
OPENAI_API_KEY=
# Realtime speech-to-speech model and voice (marin and cedar sound best).
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=cedar
# Reasoning effort for gpt-realtime-2.x models: minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
# What the caller says is transcribed with this model (shown on the HUD).
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Twilio (the phone line) ---
# The number pilots call, in E.164 form. It is also shown on the game's HUD.
TWILIO_PHONE_NUMBER=+15550109001
# Needed to check webhook signatures and for `npm run configure-twilio`.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- This relay ---
PORT=8787
# The public https URL Twilio reaches this relay at, e.g. your ngrok URL.
# With TWILIO_AUTH_TOKEN set, webhook signatures are checked against it.
PUBLIC_URL=
# Optional shared secret for the game link (/game) and /mcp. When set, start
# the game with  -- --ship-token=<same value>  (or SHIP_LINK_TOKEN in its env).
SHIP_LINK_TOKEN=

# The support agent's name.
AGENT_NAME=Gary
