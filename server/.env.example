# Copy to server/.env for local runs (`npm run dev`). The game reads its link
# settings (FRACTAL_SERVER_URL, GAME_LINK_TOKEN) from here too.
# On Railway set the server's variables on the service instead.

# ---- server (Railway) ----
# Public https origin Twilio calls. On Railway this defaults to
# https://$RAILWAY_PUBLIC_DOMAIN, so it only needs setting for a custom domain or a tunnel.
PUBLIC_BASE_URL=
# Twilio Console > Account > API keys & tokens > Auth token. Used to check X-Twilio-Signature.
TWILIO_AUTH_TOKEN=
# E.164 numbers allowed to pilot, comma-separated. Empty refuses every call.
ALLOWED_CALLERS=+15551234567
# Optional voice settings for <ConversationRelay>.
# WELCOME_GREETING=You're connected to the fractal. Where shall we fly?
# TTS_PROVIDER=ElevenLabs
# TTS_VOICE=
# LANGUAGE=en-US
# PARTIAL_PROMPTS=true   # live transcript in the game's chat box (Deepgram flux only)

# ---- the voice agent (VOICE_AGENT=openai) ----
# Who answers: openai (the call centre's voice agent; the default when
# OPENAI_API_KEY is set) or relay (ConversationRelay into the pilot chat).
# VOICE_AGENT=openai
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_VOICE=cedar              # marin and cedar sound best
# OPENAI_REASONING_EFFORT=low     # gpt-realtime-2.x only
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# AGENT_NAME=Gary
# The number callers ring, shown on the game's HUD.
# TWILIO_PHONE_NUMBER=+15551234567

# ---- both ----
# Shared secret between the server and the link. Generate with: openssl rand -hex 32
GAME_LINK_TOKEN=

# ---- the game's link (your machine) ----
# The server's public URL; the game dials it when it starts (or `npm run link`).
FRACTAL_SERVER_URL=https://your-service.up.railway.app
# FRACTAL_MCP_PORT=9077
