{
  "name": "fractal-phone-server",
  "version": "0.1.0",
  "private": true,
  "description": "Call in and pilot Help I'm Stuck In A Fractal by phone: Twilio ConversationRelay on Railway, linked to the game on your machine",
  "type": "module",
  "scripts": {
    "start": "node src/index.mjs",
    "link": "node --env-file-if-exists=.env link/link.mjs",
    "test": "node --test --test-force-exit test/*.test.mjs",
    "dev": "node --env-file-if-exists=.env src/index.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "express": "^5.3.0",
    "twilio": "^6.1.2",
    "ws": "^8.22.0"
  }
}
