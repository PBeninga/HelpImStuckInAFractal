extends "res://tests/test_case.gd"
## Crossing the boundary locks travel and editing, but retains free look.


func run() -> void:
	var main: Node = load("res://src/main.tscn").instantiate()
	root.add_child(main)
	await frames(2)
	main.camera.set_eye(0.0, 0.0, 0.0)
	main.params.gameplay.distance_scaling = false
	main.console().open()
	main.camera.set_eye(21.0, 0.0, 0.0)
	check(not main.console().visible, "escape hides the console")
	check(not main.chat().visible, "escape hides the chat controls")
	check(not main._axis_controller.is_processing(), "escape disables shape control keys")
	var eye: PackedFloat64Array = main.camera.eye64()
	Input.action_press("move_forward")
	Input.action_press("sprint")
	main.fly._step_movement(0.5)
	Input.action_release("move_forward")
	Input.action_release("sprint")
	check_eq(main.camera.eye64(), eye, "held movement and sprint cannot move after escape")
	var forward: Vector3 = main.camera.forward()
	var motion := InputEventMouseMotion.new()
	motion.relative = Vector2(40.0, 20.0)
	main._unhandled_input(motion)
	check(main.camera.forward() != forward, "mouse look remains active during escape")
	check_eq(main.camera.eye64(), eye, "looking preserves the full precision position")
	main._on_console_toggle()
	main._toggle_noise()
	check(not main.console().visible and not main.noise_window().visible,
		"editor shortcuts cannot reopen controls during escape")
	main.params.camera_mode = FractalParams.CameraMode.ORBIT
	forward = main.camera.forward()
	main._unhandled_input(motion)
	check(main.camera.forward() != forward, "escape retains free look even in orbit mode")
	check_eq(main.camera.eye64(), eye, "switching to orbit cannot move the escaped camera")
	main.view._process(10.0)
	Input.action_press("move_back")
	main.fly._step_movement(0.5)
	Input.action_release("move_back")
	check_eq(main.camera.eye64(), eye, "completed escape keeps travel locked")
	main.params.camera_mode = FractalParams.CameraMode.FLY
	main.return_to_spawn()
	check(main.chat().visible, "return to spawn restores chat")
	check(main._axis_controller.is_processing(), "return to spawn restores shape controls")
	main.console().hide_console()
	main._drop_side_focus()
	eye = main.camera.eye64()
	Input.action_press("move_forward")
	main.fly._step_movement(0.1)
	Input.action_release("move_forward")
	check(main.camera.eye64() != eye, "return to spawn unlocks movement")
	main.queue_free()
	await frames(1)
