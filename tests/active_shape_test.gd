extends "res://tests/test_case.gd"

func run() -> void:
	var script = load("res://src/gameplay/shape_run.gd")
	check(script != null, "active-shape run controller exists")
	if script == null:
		return
	var shapes := ShapeList.new(2)
	shapes.table(0).set_default(&"shape", FractalParams.Shape.KLEINIAN)
	shapes.set_stage(0, 2.0, ["inversion -0.5"])
	shapes.set_stage(1, 4.0, ["box_scale -1.5"])
	var restored := ShapeList.new()
	check_eq(restored.apply_dict(shapes.to_dict()), [], "stage configuration loads")
	check_eq(restored.entry(1).commands, ["box_scale -1.5"], "commands persist")
	check_eq(restored.entry(1).escape_distance, 4.0, "distance persists")
	var params := FractalParams.new()
	params.set_shape_count(2)
	params.shape(0).apply_resolved(shapes.table(0).defaults())
	params.shape(1).apply_resolved(shapes.table(1).defaults())
	params.gameplay.spawn_x = 10.0
	var camera := CameraState.make_default()
	camera.set_eye(10.0, 0.0, 0.0)
	var run = script.new(shapes, params, camera)
	run.reset()
	check_eq(params.gameplay_active, 0, "first shape is gameplay active")
	params.active = 1
	check_eq(params.visible_shape_indices(), [0], "editor selection does not reveal inactive shapes")
	camera.set_eye(12.1, 0.0, 0.0)
	run.check_position()
	check(not run.transitioning() and not run.escaped, "radius alone cannot bypass required command")
	var id: String = run.run_id()
	check(not run.apply_command("inversion -0.5", id, 0, run.command_index, run.human_turn).ok, "startup cannot execute a command")
	run.note_human_message("help me get out")
	check(not run.apply_command("inversion -0.5", id, 1, run.command_index, run.human_turn).ok, "inactive target rejected")
	check(run.apply_command("inversion -0.5", id, 0, run.command_index, run.human_turn).ok, "human-prompted command accepted")
	check_eq(run.overrides(0).get(&"kleinian_radius"), 0.5, "inversion delta opens the existing radius")
	check_eq(shapes.table(0).get_default(&"kleinian_radius"), 1.0, "authored shape stays unchanged")
	check_eq(run.overrides(1), {}, "inactive shape not changed")
	check(not run.apply_command("inversion -0.5", id, 0, run.command_index, run.human_turn).ok, "duplicate command rejected")
	run.check_position()
	check(run.transitioning() and not run.escaped, "intermediate boundary starts fog, not escape")
	run.step(1.0)
	check_eq(run.fog_alpha, 1.0, "swap fully covered")
	check_eq(params.gameplay_active, 1, "next stage becomes active under fog")
	run.step(0.1)
	run.step(1.0)
	check(not run.transitioning(), "fog clears after reveal")
	check(not run.apply_command("box_scale -1.5", id, 1, run.command_index, run.human_turn).ok, "new stage does not authorize a command")
	run.note_human_message("open this one")
	check(run.apply_command("box_scale -1.5", id, 1, run.command_index, run.human_turn).ok, "second stage accepts its own command")
	camera.set_eye(14.0, 0.0, 0.0)
	run.check_position()
	check(not run.escaped, "exact boundary remains inside")
	camera.set_eye(14.1, 0.0, 0.0)
	run.check_position()
	check(run.escaped and params.run_escaped, "only last completed stage escapes")
	camera.set_eye(10.0, 0.0, 0.0)
	run.reset()
	check_eq(params.gameplay_active, 0, "reset restores first stage")
	check_eq(run.overrides(0), {}, "reset restores authored geometry")
	run.note_human_message("again")
	check(not run.apply_command("inversion -0.5", id, 0, run.command_index, run.human_turn).ok, "stale run command rejected")
	check(not shapes.set_stage(0, -1.0, []), "invalid distance rejected")
	check(not shapes.set_stage(0, 2.0, ["unknown 4"]), "invalid command rejected")
	check(not shapes.set_stage(0, 2.0, ["inversion -100"]), "impossible inversion rejected")
	var legacy := ShapeList.new()
	check_eq(legacy.apply_dict([{"label": "Legacy", "defaults": {}, "bindings": {}}]), [], "legacy level migrates without warnings")
	check_eq(legacy.entry(0).commands, [], "legacy shapes preserve distance-only escape")
	var invalid := legacy.to_dict()
	invalid[0]["commands"] = ["inversion -100"]
	check(not legacy.apply_dict(invalid).is_empty(), "invalid saved script warns")
	check_eq(legacy.entry(0).commands, ["inversion -100"], "invalid objectives remain blocked instead of silently disappearing")
	for kind in [FractalParams.Shape.KIFS, FractalParams.Shape.KLEINIAN, FractalParams.Shape.MANDELBULB]:
		var list := ShapeList.new()
		var index := list.add({&"shape": kind})
		check(list.entry(index).commands.is_empty(), "new stage has no example commands")
		check_eq(ShapeList.validate_commands(list.table(index), Array(list.entry(index).commands)), "", "default stage command is supported")
	_review_regressions(script)

func _review_regressions(script: Script) -> void:
	var shapes := ShapeList.new()
	shapes.table(0).set_default(&"shape", FractalParams.Shape.KLEINIAN)
	shapes.set_stage(0, 20.0, ["inversion -0.1", "inversion -0.1"])
	var params := FractalParams.new()
	params.shape().apply_resolved(shapes.table(0).defaults())
	# Equivalent to an axis binding resolving the radius above its authored default.
	params.shape().kleinian_radius = 2.0
	var run = script.new(shapes, params, CameraState.make_default())
	run.reset()
	run.note_human_message("open it")
	var token: int = run.human_turn
	check(run.apply_command("inversion -0.1", run.run_id(), 0, run.command_index, run.human_turn).ok, "bound inversion command applies")
	check_approx(run.overrides(0).get(&"kleinian_radius", -1), 1.9, "inversion delta uses current resolved radius")
	run.note_human_message("what happened?")
	check(not run.apply_command("inversion -0.1", run.run_id(), 0, 0, token).ok,
		"delayed retry cannot consume a new utterance for an identical next command")
