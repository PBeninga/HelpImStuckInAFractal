extends "res://tests/test_case.gd"
## Catches full-resolution rays returning at idle, stale UI/material state, and
## losing painterly settings during a level round-trip.

func run() -> void:
	var params := FractalParams.new()
	check(params.get("painterly_enabled") != null, "renderer exposes opt-in painterly settings")
	if params.get("painterly_enabled") == null:
		return
	var view: FractalView = load("res://src/fractal/fractal_view.tscn").instantiate()
	root.add_child(view)
	await frames(1)
	view.set_anchors_preset(Control.PRESET_TOP_LEFT)
	view.size = Vector2(1200, 800)
	view.setup(params, CameraState.make_default())
	check_eq(view.viewport_size(), Vector2i(1200, 800), "disabled mode keeps original ray resolution")
	check(view._display.texture == view._viewport.get_texture(), "disabled mode keeps original presentation")
	params.set("painterly_scale", 0.25)
	params.set("painterly_enabled", true)
	check_eq(view.viewport_size(), Vector2i(300, 200), "painting marches one sixteenth as many primary rays")
	check(view.get("_paint_viewport") != null and view._display.texture != view._viewport.get_texture(), "full-size display presents the brush shader")
	check_eq((view.get("_paint_viewport") as SubViewport).size, Vector2i(1200, 800), "capture target preserves full presentation resolution")
	check_eq(view._display.size, Vector2(1200, 800), "brush presentation stays full size")
	var governor := ResolutionGovernor.new()
	governor.setup(params, view)
	governor.mark_changed()
	governor._process(0.02)
	governor._process(0.2)
	governor._process(0.02)
	check_eq(governor.mode, ResolutionGovernor.Mode.IDLE, "governor reaches idle")
	check_eq(view.viewport_size(), Vector2i(300, 200), "idle final frame preserves ray savings")
	view.set_render_scale(0.1)
	check_eq(view.viewport_size(), Vector2i(120, 80), "governor can reduce rays further under load")
	view.set_render_scale(1.0)
	params.set("painterly_brush_size", 20.0)
	check_approx(view.get("_brush_material").get_shader_parameter("brush_size"), 20.0, "brush changes reach presentation immediately")
	var ui := RendererOptions.new()
	root.add_child(ui)
	await frames(1)
	ui.setup(params)
	var toggle: CheckBox = ui.get("painterly_check")
	check(toggle != null and toggle.button_pressed, "renderer UI follows enabled painterly mode")
	if toggle != null:
		toggle.button_pressed = false
	check_eq((view.get("_paint_viewport") as SubViewport).render_target_update_mode, SubViewport.UPDATE_DISABLED, "disabled painting stops the extra presentation pass")
	check_eq(view.viewport_size(), Vector2i(1200, 800), "UI toggle restores full-resolution rays immediately")
	check(view._display.texture == view._viewport.get_texture(), "UI toggle removes painting material")
	var scale_control: HSlider = ui.get("painterly_scale_slider")
	if toggle != null and scale_control != null:
		toggle.button_pressed = true
		scale_control.value = 0.4
		await frames(1)
		check_eq(view.viewport_size(), Vector2i(480, 320), "ray resolution UI changes the actual viewport")
	var shapes := ShapeList.new()
	var look := AttributeTable.new(ShapeCatalogue.scene_specs())
	var keymap := Keymap.new()
	var camera := CameraState.make_default()
	var data := Workspace.capture(shapes, look, keymap, params, camera)
	var restored := FractalParams.new()
	Workspace.restore(data, shapes, look, keymap, restored, camera)
	check_eq(restored.get("painterly_enabled"), true, "level restores enabled mode")
	check_approx(restored.get("painterly_scale"), 0.4, "level restores ray scale")
	check_approx(restored.get("painterly_brush_size"), 20.0, "level restores brush size")
	var legacy: Dictionary = data.duplicate(true)
	for key in ["painterly_enabled", "painterly_scale", "painterly_brush_size"]:
		legacy["fractal"].erase(key)
	Workspace.restore(legacy, shapes, look, keymap, restored, camera)
	check_eq(restored.get("painterly_enabled"), false, "loading an older level does not inherit painting from the previous level")
	params.set("painterly_scale", 0.0)
	check_eq(view.viewport_size(), Vector2i(120, 80), "invalid zero scale clamps to safe nonzero ray budget")
	ui.reset_defaults()
	check_eq(view.viewport_size(), Vector2i(1200, 800), "reset defaults restores original renderer")
	check(view._display.texture == view._viewport.get_texture(), "reset defaults disables brush presentation")
	governor.free()
	ui.free()
	view.queue_free()
	await frames(1)
